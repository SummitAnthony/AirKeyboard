<?xml version="1.0" encoding="utf-8"?>
<!-- Window wallpaper "Red" (Settings > Theme > Red): near-black base, a deep crimson glow from the
     top-right and a faint diagonal line texture -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"><item><color android:color="@color/base" /></item><item><shape><gradient android:type="radial" android:centerX="0.95" android:centerY="0.0" android:gradientRadius="95%" android:startColor="#D98B0A1E" android:endColor="#008B0A1E" /></shape></item><item><shape><gradient android:type="radial" android:centerX="1.0" android:centerY="0.0" android:gradientRadius="45%" android:startColor="#80E5373F" android:endColor="#00E5373F" /></shape></item><item><shape><gradient android:type="radial" android:centerX="0.05" android:centerY="1.0" android:gradientRadius="70%" android:startColor="#404A0812" android:endColor="#004A0812" /></shape></item><item><bitmap android:src="@drawable/bg_lines" android:tileMode="repeat" /></item></layer-list>
