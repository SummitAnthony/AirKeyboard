<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: Recent PCs + Scan QR on the left, manual form on the right. Same ids as layout/ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="20dp"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_to_device"
            android:textAppearance="@style/TextAppearance.Glass.ScreenTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- PCs connected to before, newest first; hidden while there are none -->
                <LinearLayout
                    android:id="@+id/recentSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/recent_pcs"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/recent_pcs_hint"
                        android:textAppearance="@style/TextAppearance.Glass.Caption" />

                    <!-- item_recent_pc rows; each has a 10dp bottom margin -->
                    <LinearLayout
                        android:id="@+id/recentList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnScanQR"
                    style="@style/Widget.Glass.Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_primary"
                    android:layout_marginTop="10dp"
                    android:text="@string/scan_qr_code"
                    app:icon="@drawable/ic_qr"
                    app:iconSize="18dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:minHeight="41dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/or_manual_connection"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <!-- Grouped glass form: Host / Port rows with inline labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_primary"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:labelFor="@+id/etHost"
                            android:text="@string/connection_host_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/etHost"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="@string/host_ip_address"
                            android:inputType="text"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingBottom="0dp"
                            android:paddingEnd="0dp"
                            android:paddingStart="0dp"
                            android:paddingTop="0dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="17sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1FFFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_primary"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:labelFor="@+id/etPort"
                            android:text="@string/connection_port_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/etPort"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="@string/connection_port_hint"
                            android:inputType="number"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingBottom="0dp"
                            android:paddingEnd="0dp"
                            android:paddingStart="0dp"
                            android:paddingTop="0dp"
                            android:text="1978"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="17sp" />

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btnConnectManual"
                    style="@style/Widget.Glass.Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_primary"
                    android:layout_marginTop="12dp"
                    android:text="@string/connect" />

                <Button
                    android:id="@+id/btnAutoDiscover"
                    style="@style/Widget.Glass.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_secondary"
                    android:layout_marginTop="6dp"
                    android:text="@string/auto_discover"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/text_primary"
                    android:visibility="gone" />

                <!-- "Reconnecting to <host>…" while the connection screen retries a lost PC -->
                <TextView
                    android:id="@+id/tvReconnecting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:textAppearance="@style/TextAppearance.Glass.Secondary"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
