<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Settings content column: full width here, 760dp centered on wide screens (values-w900dp) -->
    <style name="Settings.Content" parent="">
        <item name="android:layout_width">match_parent</item>
    </style>

    <!-- Dark mode segmented control: full width here, 420dp from 600dp up (values-w600dp) -->
    <style name="Settings.SegmentGroup" parent="">
        <item name="android:layout_width">match_parent</item>
    </style>

    <!-- Segment inside the MaterialButtonToggleGroup. The group reads and rewrites each button's
         shape, which throws if android:background is overwritten (as in Widget.Glass.Button.Segment),
         so the button keeps its own background (transparent) and the selected pill is the foreground. -->
    <style name="Settings.Segment" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:foreground">@drawable/bg_segment</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/settings_segment_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
