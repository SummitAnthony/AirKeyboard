<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Glass theme (AirKeyboard Glass spec): always dark, no action bar (each screen draws its own
         60dp app bar), the gradient wallpaper behind everything, glass buttons by default. -->
    <style name="Theme.AirKeyboard" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="android:colorBackground">@color/base</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Every Button / MaterialButton is glass unless a layout picks another Widget.Glass style -->
        <item name="materialButtonStyle">@style/Widget.Glass.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Glass.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.Glass.Button.Text</item>
        <item name="switchStyle">@style/Widget.Glass.Switch</item>
        <item name="sliderStyle">@style/Widget.Glass.Slider</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Glass.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Glass.Dialog</item>
        <item name="editTextStyle">@style/Widget.Glass.EditText</item>
    </style>

    <style name="Theme.AirKeyboard.NoActionBar">
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Dialogs: glass sheet, black 35% scrim, text buttons in the link blue -->
    <style name="ThemeOverlay.Glass.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_glass_sheet</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="colorPrimary">@color/link</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Glass.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Glass.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Glass.DialogButton</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Glass.DialogTitle</item>
        <item name="editTextStyle">@style/Widget.Glass.EditText</item>
    </style>

    <style name="Widget.Glass.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/link</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <!-- Buttons. Usage: style="@style/Widget.Glass.Button.Strong" etc. Plain <Button> = Widget.Glass.Button -->
    <style name="Widget.Glass.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_glass</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:textColor">@color/glass_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/height_secondary</item>
        <item name="android:minWidth">0dp</item>
        <item name="iconTint">@color/glass_text</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">17dp</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.Glass.Button.Strong">
        <item name="android:background">@drawable/bg_glass_strong</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Glass.Button.Subtle">
        <item name="android:background">@drawable/bg_glass_subtle</item>
    </style>
    <style name="Widget.Glass.Button.Accent">
        <item name="android:background">@drawable/bg_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/height_primary</item>
    </style>
    <style name="Widget.Glass.Button.Destructive">
        <item name="android:textColor">@color/destructive</item>
        <item name="iconTint">@color/destructive</item>
    </style>
    <!-- App bar action (Back, Disconnect): 36dp glass pill -->
    <style name="Widget.Glass.Button.Pill">
        <item name="android:background">@drawable/bg_glass_pill</item>
        <item name="android:minHeight">@dimen/height_pill</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Widget.Glass.Button.Pill.Destructive">
        <item name="android:textColor">@color/destructive</item>
    </style>
    <style name="Widget.Glass.Button.Pill.Accent">
        <item name="android:background">@drawable/bg_accent_pill</item>
    </style>
    <!-- Keys: 44dp, 13dp radius -->
    <style name="Widget.Glass.Button.Key">
        <item name="android:background">@drawable/bg_glass_key</item>
        <item name="android:minHeight">@dimen/height_key</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:maxLines">1</item>
    </style>
    <!-- Ctrl/Alt/Shift/Win: blue tint, accent when checked/activated/selected (latched) -->
    <style name="Widget.Glass.Button.Modifier" parent="Widget.Glass.Button.Key">
        <item name="android:background">@drawable/bg_modifier</item>
    </style>
    <!-- Text-only action (Auto Discover, Cancel): link blue -->
    <style name="Widget.Glass.Button.Text">
        <item name="android:background">@drawable/bg_text_button</item>
        <item name="android:textColor">@color/link</item>
        <item name="iconTint">@color/link</item>
    </style>
    <!-- Push-to-talk (bg_mic has a 6dp inset for the glow ring) -->
    <style name="Widget.Glass.Button.Mic">
        <item name="android:background">@drawable/bg_mic</item>
        <item name="android:textColor">@color/mic_idle_text</item>
        <item name="iconTint">@color/mic_idle_text</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
    <!-- One segment of a segmented control in bg_segment_track. A MaterialButtonToggleGroup throws on
         buttons whose background is replaced, so this keeps the button's own (transparent) background
         and draws the selected pill as the foreground. -->
    <style name="Widget.Glass.Button.Segment" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:foreground">@drawable/bg_segment</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/glass_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="Widget.Glass.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="track">@drawable/switch_track</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@null</item>
        <item name="switchMinWidth">51dp</item>
    </style>

    <style name="Widget.Glass.Slider" parent="Widget.MaterialComponents.Slider">
        <item name="trackHeight">6dp</item>
        <item name="trackColorActive">@color/text_primary</item>
        <item name="trackColorInactive">#33FFFFFF</item>
        <item name="thumbColor">@android:color/white</item>
        <item name="thumbRadius">13dp</item>
        <item name="thumbElevation">4dp</item>
        <item name="haloColor">#1FFFFFFF</item>
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
    </style>

    <style name="Widget.Glass.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:background">@drawable/bg_glass_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">@dimen/height_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Glass containers -->
    <style name="Widget.Glass.Card" parent="">
        <item name="android:background">@drawable/bg_glass_card</item>
    </style>

    <!-- Type scale -->
    <style name="TextAppearance.Glass.AppBarTitle" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Glass.ScreenTitle" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.Glass.Title" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Glass.DialogTitle" parent="TextAppearance.Glass.Title" />
    <style name="TextAppearance.Glass.SectionHeader" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#99FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <style name="TextAppearance.Glass.RowTitle" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.Glass.Secondary" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.Glass.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Legacy names kept so nothing breaks; now glass -->
    <style name="TextAppearance.AirKeyboard.Headline" parent="TextAppearance.Glass.AppBarTitle" />

    <style name="TextAppearance.AirKeyboard.Body" parent="TextAppearance.Glass.RowTitle" />

    <style name="TextAppearance.AirKeyboard.Caption" parent="TextAppearance.Glass.Caption" />

    <style name="Widget.AirKeyboard.SettingsSection" parent="TextAppearance.Glass.SectionHeader">
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">16dp</item>
    </style>

    <style name="Widget.AirKeyboard.SettingsCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.AirKeyboard.SettingsSwitch" parent="Widget.Glass.Switch">
        <item name="android:minHeight">54dp</item>
    </style>
</resources>
