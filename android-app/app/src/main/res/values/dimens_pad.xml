<?xml version="1.0" encoding="utf-8"?>
<!-- Trackpad and Settings on phones. Phones held upright (this file): the connection pill sits under
     the screen title, and the five buttons under the click row show only their icons. Phone landscape:
     values-land. Tablets (smallest width 686dp) keep today's look: values-sw600dp. -->
<resources>
    <!-- App bar: title above a smaller connection pill (orientation 1 = vertical); the title isn't stretched -->
    <integer name="pad_app_bar_orientation">1</integer>
    <item name="pad_title_weight" format="float" type="dimen">0</item>
    <dimen name="pad_status_height">26dp</dimen>
    <dimen name="pad_status_padding_h">10dp</dimen>
    <dimen name="pad_status_margin_start">0dp</dimen>
    <dimen name="pad_status_margin_top">2dp</dimen>

    <!-- Scroll Up/Down, Keyboard, Remotes, Settings: icon only; TrackpadActivity keeps each label as
         the content description -->
    <bool name="pad_nav_labels">false</bool>
    <dimen name="pad_nav_icon_size">20dp</dimen>
    <dimen name="pad_nav_icon_padding">0dp</dimen>

    <!-- Phones in both orientations: tighter gaps between the trackpad buttons (the mic's margin is the
         gap minus its 6dp ring inset), a wider Middle, a little less padding around the pad hint -->
    <dimen name="pad_button_gap">6dp</dimen>
    <dimen name="pad_mic_margin_start">0dp</dimen>
    <item name="pad_middle_weight" format="float" type="dimen">1.25</item>
    <dimen name="pad_hint_padding">20dp</dimen>
</resources>
