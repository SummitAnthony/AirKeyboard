<?xml version="1.0" encoding="utf-8"?>
<!-- Touch glow that follows the finger on the trackpad: white 55% center fading out, 1dp white 45% ring -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="42dp"
        android:startColor="#8CFFFFFF"
        android:centerColor="#45FFFFFF"
        android:endColor="#00FFFFFF" />
    <stroke android:width="1dp" android:color="#73FFFFFF" />
    <size android:width="84dp" android:height="84dp" />
</shape>
