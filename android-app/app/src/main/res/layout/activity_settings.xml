<?xml version="1.0" encoding="utf-8"?>
<!-- Every setting saves as soon as it changes; the control screens read them in onResume.
     The root stays the ScrollView (SmokeTest scrolls android.R.id.content's first child), so the
     app bar scrolls with the list. Grouped list, 760dp centered on wide screens (Settings.Content). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <!-- Title and connection pill in a row; on phones held upright the pill goes under the title
             (dimens_pad, as on the trackpad), so a long PC address still fits -->
        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_app_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="@integer/pad_app_bar_orientation">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="@dimen/pad_title_weight"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_title"
                    android:textAppearance="@style/TextAppearance.Glass.AppBarTitle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/pad_status_height"
                    android:layout_marginStart="@dimen/pad_status_margin_start"
                    android:layout_marginTop="@dimen/pad_status_margin_top"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/pad_status_padding_h">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_dot_connected" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/connected"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:visibility="@integer/landscape_only_visibility" />

                    <TextView
                        android:id="@+id/tvConnectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnBack"
                style="@style/Widget.Glass.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_pill"
                android:layout_marginStart="10dp"
                android:text="@string/back" />

        </LinearLayout>

        <LinearLayout
            style="@style/Settings.Content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Pointer -->
            <TextView
                style="@style/Widget.AirKeyboard.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_section_pointer" />

            <LinearLayout
                style="@style/Widget.Glass.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="31dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sensitivity"
                            android:textAppearance="@style/TextAppearance.Glass.RowTitle" />

                        <TextView
                            android:id="@+id/tvSensitivityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFeatureSettings="tnum"
                            android:text="100%"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:valueFrom="10"
                        android:valueTo="200" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/rowAcceleration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/height_row"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_acceleration"
                            android:textAppearance="@style/TextAppearance.Glass.RowTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_acceleration_sub"
                            android:textAppearance="@style/TextAppearance.Glass.Caption" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAcceleration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_acceleration" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/rowThreeFingerDrag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/height_row"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:paddingVertical="10dp"
                        android:text="@string/settings_three_finger_drag"
                        android:textAppearance="@style/TextAppearance.Glass.RowTitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchThreeFingerDrag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_three_finger_drag" />

                </LinearLayout>

            </LinearLayout>

            <!-- Scrolling -->
            <TextView
                style="@style/Widget.AirKeyboard.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_scrolling" />

            <LinearLayout
                style="@style/Widget.Glass.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowNaturalScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/height_row"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_natural_scroll"
                            android:textAppearance="@style/TextAppearance.Glass.RowTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_natural_scroll_sub"
                            android:textAppearance="@style/TextAppearance.Glass.Caption" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNaturalScroll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_natural_scroll" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="31dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_scroll_speed"
                            android:textAppearance="@style/TextAppearance.Glass.RowTitle" />

                        <TextView
                            android:id="@+id/tvScrollSpeedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFeatureSettings="tnum"
                            android:text="100%"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderScrollSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:stepSize="5"
                        android:valueFrom="25"
                        android:valueTo="300" />

                </LinearLayout>

            </LinearLayout>

            <!-- Buttons -->
            <TextView
                style="@style/Widget.AirKeyboard.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_buttons" />

            <LinearLayout
                style="@style/Widget.Glass.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowLeftHanded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/height_row"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_left_handed"
                            android:textAppearance="@style/TextAppearance.Glass.RowTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_left_handed_sub"
                            android:textAppearance="@style/TextAppearance.Glass.Caption" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchLeftHanded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_left_handed" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/rowVolumeKeys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/height_row"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:paddingVertical="10dp"
                        android:text="@string/settings_volume_keys"
                        android:textAppearance="@style/TextAppearance.Glass.RowTitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchVolumeKeys"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_volume_keys" />

                </LinearLayout>

            </LinearLayout>

            <!-- Display -->
            <TextView
                style="@style/Widget.AirKeyboard.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_display" />

            <LinearLayout
                style="@style/Widget.Glass.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowKeepAwake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/height_row"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:paddingVertical="10dp"
                        android:text="@string/settings_keep_awake"
                        android:textAppearance="@style/TextAppearance.Glass.RowTitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchKeepAwake"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_keep_awake" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="13dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_theme"
                        android:textAppearance="@style/TextAppearance.Glass.RowTitle" />

                    <!-- Segmented control: the track is the group's background, the selected pill each
                         button's foreground (see Settings.Segment) -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleTheme"
                        style="@style/Settings.SegmentGroup"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_segment_track"
                        android:padding="3dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btnThemeBlue"
                            style="@style/Settings.Segment"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="@string/settings_theme_blue" />

                        <Button
                            android:id="@+id/btnThemeRed"
                            style="@style/Settings.Segment"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="@string/settings_theme_red" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnForgetPasswords"
                style="@style/Widget.Glass.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:text="@string/settings_forget_passwords"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
