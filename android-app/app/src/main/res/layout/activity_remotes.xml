<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_h"
    android:paddingBottom="@dimen/screen_padding_bottom">

    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_app_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- Title and connection pill in a row; on phones held upright the pill goes under the title
             (dimens_rem, as on the trackpad), so a long PC address still fits -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="@integer/rem_app_bar_orientation">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="@dimen/rem_title_weight"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/remotes"
                android:textAppearance="@style/TextAppearance.Glass.AppBarTitle" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/rem_status_height"
                android:layout_marginStart="@dimen/rem_status_margin_start"
                android:layout_marginTop="@dimen/rem_status_margin_top"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/rem_status_padding_h">
                <View android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/bg_dot_connected" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/connected"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="@integer/landscape_only_visibility" />
                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Glass.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/height_pill"
            android:layout_marginStart="10dp"
            android:text="@string/back" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="4dp"
        android:text="@string/remote_tools"
        android:textAppearance="@style/TextAppearance.Glass.SectionHeader" />

    <!-- Tiles that open the other remotes: one row of five; on phones held upright 3 + 2
         (rem_tile_columns). Each tile has half a gap on every side; the grid's negative margins take
         that off its edges, so the tiles line up with the screen padding (9dp = 14dp less half a gap). -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rem_grid_half_gap_neg"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="@dimen/rem_grid_half_gap_neg"
        android:layout_marginBottom="@dimen/rem_grid_half_gap_neg"
        android:columnCount="@integer/rem_tile_columns">

        <LinearLayout
            android:id="@+id/btnPower"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal|top"
            android:layout_margin="@dimen/rem_grid_half_gap"
            android:background="@drawable/bg_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:stateListAnimator="@animator/press_scale">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile"
                android:backgroundTint="@color/tile_power"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_power" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/hub_power"
                android:textColor="@color/text_primary"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="@dimen/rem_tile_label_min_text"
                app:autoSizeTextType="uniform" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPresentation"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal|top"
            android:layout_margin="@dimen/rem_grid_half_gap"
            android:background="@drawable/bg_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:stateListAnimator="@animator/press_scale">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile"
                android:backgroundTint="@color/tile_presentation"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_presentation" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/hub_presentation"
                android:textColor="@color/text_primary"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="@dimen/rem_tile_label_min_text"
                app:autoSizeTextType="uniform" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnApps"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal|top"
            android:layout_margin="@dimen/rem_grid_half_gap"
            android:background="@drawable/bg_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:stateListAnimator="@animator/press_scale">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile"
                android:backgroundTint="@color/tile_apps"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_windows" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/hub_app_switcher"
                android:textColor="@color/text_primary"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="@dimen/rem_tile_label_min_text"
                app:autoSizeTextType="uniform" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnBookmarks"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal|top"
            android:layout_margin="@dimen/rem_grid_half_gap"
            android:background="@drawable/bg_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:stateListAnimator="@animator/press_scale">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile"
                android:backgroundTint="@color/tile_bookmarks"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_bookmark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/hub_bookmarks"
                android:textColor="@color/text_primary"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="@dimen/rem_tile_label_min_text"
                app:autoSizeTextType="uniform" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAirMouse"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal|top"
            android:layout_margin="@dimen/rem_grid_half_gap"
            android:background="@drawable/bg_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:stateListAnimator="@animator/press_scale">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile"
                android:backgroundTint="@color/tile_airmouse"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_mouse" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/hub_air_mouse"
                android:textColor="@color/text_primary"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="@dimen/rem_tile_label_min_text"
                app:autoSizeTextType="uniform" />

        </LinearLayout>

    </GridLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:paddingHorizontal="4dp"
        android:text="@string/quick_commands"
        android:textAppearance="@style/TextAppearance.Glass.SectionHeader" />

    <!-- Grid of glass rows; the span count follows the width (RemotesActivity). The negative
         margin cancels the rows' 4dp outer margin so the grid lines up with the tiles. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRemotes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="-4dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false" />

</LinearLayout>
