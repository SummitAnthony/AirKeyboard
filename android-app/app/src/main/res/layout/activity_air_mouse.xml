<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_h"
    android:paddingBottom="@dimen/screen_padding_bottom">

    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_app_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Title and connection pill in a row; on phones the pill goes under the title (dimens_rem,
             as on the trackpad). In both orientations on phones: this screen keeps its first layout
             when it rotates. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="@integer/rem_air_app_bar_orientation">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="@dimen/rem_air_title_weight"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/air_mouse"
                android:textAppearance="@style/TextAppearance.Glass.AppBarTitle" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/rem_air_status_height"
                android:layout_marginStart="@dimen/rem_air_status_margin_start"
                android:layout_marginTop="@dimen/rem_air_status_margin_top"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/rem_air_status_padding_h">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_dot_connected" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/connected"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="@integer/landscape_only_visibility" />

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Glass.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/height_pill"
            android:layout_marginStart="10dp"
            android:text="@string/back" />

    </LinearLayout>

    <!-- The hint; becomes the orange warning banner when there is no gyroscope -->
    <TextView
        android:id="@+id/tvAirStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:text="@string/air_mouse_hint"
        android:textColor="#9EFFFFFF"
        android:textSize="14sp" />

    <!-- The cursor follows the tablet only while this is held (highlighted via isActivated) -->
    <TextView
        android:id="@+id/holdArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/trackpad_bg_states"
        android:gravity="center"
        android:text="@string/air_mouse_hold"
        android:textColor="#80FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAirLeft"
            style="@style/Widget.Glass.Button.Strong"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/left_click"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnAirRight"
            style="@style/Widget.Glass.Button.Strong"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/right_click"
            android:textSize="18sp" />

    </LinearLayout>

</LinearLayout>
